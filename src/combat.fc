    let sprites_for_kind = (k: enemy_kind) ->
        match k with
        | guard   -> sprites_guard
        | officer -> sprites_ofc
        | ss      -> sprites_ss
        | dog     -> sprites_dog
        | mutant  -> sprites_mut
        | hans         -> sprites_hans
        | schabbs      -> sprites_schabbs
        | gretel       -> sprites_gretel
        | giftmacher   -> sprites_giftmacher
        | fat          -> sprites_fat
        | hitler_fake  -> sprites_hitler_fake
        | mecha_hitler -> sprites_mecha_hitler
        | hitler       -> sprites_hitler
        | blinky       -> sprites_blinky
        | pinky        -> sprites_pinky
        | clyde        -> sprites_clyde
        | inky         -> sprites_inky

    // Pick the 8-way rotating sprite for this enemy based on the angle
    // from the enemy to (px, py) (usually the player): the bearing
    // atan2(e2p_y, e2p_x) minus the enemy's facing, quantized into 8
    // bins with a 22.5° (pi/8) offset.
    private let angle_sprite = (e: const enemy*, px: f64, py: f64, base: i32) ->
        let e2p_x = px - e.x
        let e2p_y = e.y - py      // flip to std-math y-up
        let a_e2p = math.atan2(e2p_y, e2p_x)
        let a_face = (f64) e.dir * math.pi / 4.0
        let mut rel = a_e2p - a_face + math.pi / 8.0
        let two_pi = 2.0 * math.pi
        loop
            if rel >= 0.0 then break
            rel = rel + two_pi
        loop
            if rel < two_pi then break
            rel = rel - two_pi
        let mut bin = (i32) (rel / (math.pi / 4.0))
        if bin < 0 then bin = 0
        if bin > 7 then bin = 7
        base + bin

    // VSWAP page (relative to sprite_start) for this enemy in its
    // current state. Frame counts come from the original's states[]
    // table; animation loops for walk states and plays once for die /
    // shoot / pain. Mommy Mode (driven through `mommy_mode_fade`) skips
    // the gory die_frames in favor of the cached last-live sprite.
    let sprite_page_with_mode = (e: const enemy*, px: f64, py: f64, mommy_mode_fade: bool) ->
        let sp = sprites_for_kind(e.kind)
        let rotating = kind_is_rotating(e.kind)
        match e.state with
        | stand ->
            // Dogs have no stand pose — fall back to walk-frame 1.
            // Bosses / ghosts are single-view: just use stand_base
            // directly.
            if rotating then angle_sprite(e, px, py, sp.stand_base)
            else sp.stand_base
        | path | chase ->
            // Walk cycle: 4 phases of 8 angles. anim_frame cycles 0..3.
            // Bosses have 4 sequential walk frames; pacman ghosts only
            // have 2, so an unclamped `walk_base + ph` for inky would
            // spill into Hans's sprite block (296+).
            let ph = e.anim_frame % 4
            if rotating then angle_sprite(e, px, py, sp.walk_base + ph * 8)
            else
                let phase = match e.kind with
                    | blinky | pinky | clyde | inky -> ph % 2
                    | _ -> ph
                sp.walk_base + phase
        | shoot ->
            let f = if e.anim_frame < sp.num_shoot_frames then e.anim_frame else sp.num_shoot_frames - 1
            sp.shoot_frames[f]
        | pain ->
            // Alternate pain pose if the kind has two. anim_frame 0 = pain1.
            if e.anim_frame == 0 then sp.pain1 else sp.pain2
        | die ->
            if mommy_mode_fade && e.mommy_fade_page >= 0 then
                e.mommy_fade_page
            else if e.anim_frame < 0 then
                // The upright hold before a death-cam boss collapses:
                // the first walk pose, as in the original.
                sp.walk_base
            else
                let f = if e.anim_frame < sp.num_die_frames then e.anim_frame else sp.num_die_frames - 1
                sp.die_frames[f]
        | dead -> sp.dead_frame

    // Backwards-compatible alias for the non-mommy-mode lookup. Used
    // anywhere that doesn't have a `game*` handy (currently nothing
    // outside this module — callers in `kill_enemy` need the live page
    // captured before the state flips, and that's mommy-mode-irrelevant
    // because the enemy is still in its live state at the call site).
    let sprite_page = (e: const enemy*, px: f64, py: f64) ->
        sprite_page_with_mode(e, px, py, false)

    // ============================================================
    // Enemy AI — per-frame state machine, pathfinding, line-of-sight,
    // damage application, death handling. Nested under `enemies`
    // because it operates only on enemies and has no callers outside
    // the combat / phase-transition paths.
    // ============================================================

    module ai =
        import math from std::
        import random from std::

        // Step through the tilemap along (x1,y1) → (x2,y2). Returns
        // true if the ray passes without hitting a solid wall or a
        // door that's still closed enough to block. Used for enemy
        // sight checks and player-fire hit-validation.
        //
        // Tile-stepping DDA matching the original's sight algorithm:
        // one pass for each axis, sampling the tile crossed at each
        // perpendicular boundary. A door blocks iff the ray's
        // perpendicular intercept at the door tile's midline lies
        // beyond the door's open amount — partial-open semantics.
        // The original compares a 16-bit fixed-point intercept (in
        // 1/256-tile units, with the tile coord in its high byte)
        // against the door's open amount (0..0xFFFF for closed..open).
        // Equivalent in float tile units: blocked iff
        // `intercept > pos * 256.0`. A side effect of that encoding:
        // doors at low tile coords become see-through almost as soon
        // as they crack open, while doors at high tile coords stay
        // opaque longer (~25% open at tile 63). That's the original's
        // quirk, not a bug.
        let check_line_clear = (lv: const level*, x1: f64, y1: f64, x2: f64, y2: f64) ->
            let xt1 = (i32) x1
            let yt1 = (i32) y1
            let xt2 = (i32) x2
            let yt2 = (i32) y2
            let mut clear = true

            // X-stepping pass: walk tile boundaries in x, sampling the
            // tile we're about to leave at its midline in y.
            let xdist = if xt2 > xt1 then xt2 - xt1 else xt1 - xt2
            if xdist > 0 then
                let xstep = if xt2 > xt1 then 1 else -1
                let partial_x = if xt2 > xt1 then 1.0 - (x1 - (f64) xt1)
                                             else x1 - (f64) xt1
                let dx_abs = math.abs(x2 - x1)
                let ystep = (y2 - y1) / dx_abs
                let mut yfrac = y1 + ystep * partial_x
                let mut x = xt1 + xstep
                let xt2_end = xt2 + xstep
                loop
                    if x == xt2_end then break
                    let y = (i32) yfrac
                    yfrac = yfrac + ystep
                    if x < 0 || x >= map_size || y < 0 || y >= map_size then
                        clear = false
                        break
                    let t = (i32) lv.tilemap[(i64) x * 64 + (i64) y]
                    x = x + xstep
                    if t >= 1 && t <= 63 then
                        clear = false
                        break
                    if t >= 128 then
                        let intercept = yfrac - ystep * 0.5
                        if intercept > lv.door_pos[t - 128] * 256.0 then
                            clear = false
                            break

            if !clear then return false

            // Y-stepping pass: same idea, swapped.
            let ydist = if yt2 > yt1 then yt2 - yt1 else yt1 - yt2
            if ydist > 0 then
                let ystep_dir = if yt2 > yt1 then 1 else -1
                let partial_y = if yt2 > yt1 then 1.0 - (y1 - (f64) yt1)
                                             else y1 - (f64) yt1
                let dy_abs = math.abs(y2 - y1)
                let xstep = (x2 - x1) / dy_abs
                let mut xfrac = x1 + xstep * partial_y
                let mut y = yt1 + ystep_dir
                let yt2_end = yt2 + ystep_dir
                loop
                    if y == yt2_end then break
                    let x = (i32) xfrac
                    xfrac = xfrac + xstep
                    if x < 0 || x >= map_size || y < 0 || y >= map_size then
                        clear = false
                        break
                    let t = (i32) lv.tilemap[(i64) x * 64 + (i64) y]
                    y = y + ystep_dir
                    if t >= 1 && t <= 63 then
                        clear = false
                        break
                    if t >= 128 then
                        let intercept = xfrac - xstep * 0.5
                        if intercept > lv.door_pos[t - 128] * 256.0 then
                            clear = false
                            break

            clear

        // Is the player visible to the enemy right now? Mirrors the
        // original's sight check: inside 1.5 tiles on BOTH axes the
        // player is sensed outright — no facing test and no line
        // trace, so a guard just around a corner still notices you
        // (the caller has already required the areas to be connected
        // through open doors). Otherwise apply the axis-aligned
        // facing check (cardinals only — diagonals and nodir get no
        // facing filter, matching the original), then a tilemap LOS
        // ray. No distance cap: a clear LOS through open space wakes
        // at any range.
        let sees_player = (lv: const level*, g: game*, e: enemy*) ->
            let dx = g.pos_x - e.x
            let dy = g.pos_y - e.y
            let adx = math.abs(dx)
            let ady = math.abs(dy)
            if adx < 1.5 && ady < 1.5 then true
            else
                let facing_ok =
                    if e.dir == dir.east  then dx >= 0.0
                    else if e.dir == dir.north then dy <= 0.0
                    else if e.dir == dir.south then dy >= 0.0
                    else if e.dir == dir.west  then dx <= 0.0
                    else true
                if !facing_ok then false
                else check_line_clear(lv, e.x, e.y, g.pos_x, g.pos_y)

        // True iff the tile at (tx, ty) is passable for an enemy trying
        // to move INTO it. Walls block. The player's tile does not —
        // the original keeps actors off the player with the one-tile
        // stand-off in advance_move instead. Other live enemies block; a
        // corpse or an actor mid death-fall does not. Doors of any
        // state are routable for a cardinal step — advance_move
        // handles the wait-for-open pause and triggers the door to
        // open, matching the original's chase logic — but a
        // `diagonal` step treats any door that isn't fully open as
        // solid, for every kind (the original never cuts a corner
        // through a doorway). `self_idx` identifies the caller so it
        // doesn't block itself.
        //
        // A path / chase enemy committed to a direction also reserves
        // its NEXT tile here, mirroring the original's actor-occupancy
        // grid: the original updates the actor's tile to the
        // destination inside its walk routine before the next actor's
        // think runs. Without this, two enemies can both pass each
        // other's passability check (each sees the other still parked
        // at its source tile), both commit to the same target tile,
        // and advance_move slides them through each other into the
        // same square.
        private let tile_passable = (lv: level*, g: game*, self_idx: i32, tx: i32, ty: i32, diagonal: bool) ->
            if tx < 0 || tx >= map_size || ty < 0 || ty >= map_size then false
            else
                let t = (i32) lv.tilemap[(i64) tx * 64 + (i64) ty]
                let e = &lv.enemies[self_idx]
                if t >= 1 && t <= 63 then false
                // Door tiles block kinds that can't open doors unless
                // fully open (matches the original: actor-occupancy
                // is cleared only when the door is fully open). The
                // same rule applies to everyone on a diagonal step.
                else if t >= 128 && (diagonal || !kind_opens_doors(e.kind))
                        && lv.doors[t - 128].state != doors.door_state.open then false
                else
                    let mut blocked = false
                    for j in 0..lv.num_enemies do
                        if j == self_idx then continue
                        let oe = &lv.enemies[j]
                        match oe.state with
                        | dead | die -> void()     // corpses and the dying don't block
                        | _ ->
                            if oe.tile_x == tx && oe.tile_y == ty then blocked = true
                            else
                                let claims_next = match oe.state with
                                    | path | chase -> oe.dir != dir.nodir
                                    | _ -> false
                                if claims_next
                                        && oe.tile_x + dir.dx[oe.dir] == tx
                                        && oe.tile_y + dir.dy[oe.dir] == ty then
                                    blocked = true
                    for i in 0..lv.num_sprites do
                        let s = &lv.sprites[i]
                        if s.alive && s.blocks
                           && (i32) s.x == tx && (i32) s.y == ty then blocked = true
                    !blocked

        // Try to take a step in `d` from this enemy's current tile.
        // For diagonal moves we also insist both orthogonal neighbors
        // are open so enemies don't clip the corner of a wall (matches
        // the original's corner-cutting check), and the whole trio is
        // checked with door-is-solid semantics.
        private let try_enemy_walk = (lv: level*, g: game*, self_idx: i32, d: dir) ->
            if d == dir.nodir then false
            else
                let e = &lv.enemies[self_idx]
                let ntx = e.tile_x + dir.dx[d]
                let nty = e.tile_y + dir.dy[d]
                let diagonal = dir.dx[d] != 0 && dir.dy[d] != 0
                if !tile_passable(lv, g, self_idx, ntx, nty, diagonal) then false
                else if diagonal then
                    tile_passable(lv, g, self_idx, e.tile_x + dir.dx[d], e.tile_y, true)
                        && tile_passable(lv, g, self_idx, e.tile_x, e.tile_y + dir.dy[d], true)
                else true

        // Compose the diagonal heading that points along both `a` and
        // `b` (one east/west, one north/south, either order). Any other
        // pairing has no diagonal and yields nodir.
        private let diagonal_of = (a: dir, b: dir) ->
            let combine = (ew: dir, ns: dir) ->
                if ew == dir.east then
                    (if ns == dir.north then dir.northeast else if ns == dir.south then dir.southeast else dir.nodir)
                else if ew == dir.west then
                    (if ns == dir.north then dir.northwest else if ns == dir.south then dir.southwest else dir.nodir)
                else dir.nodir
            if a == dir.east || a == dir.west then combine(a, b)
            else combine(b, a)

        // Chase direction selector — the straight-line pursuit pick.
        // Up to two preferred directions toward the player (the larger
        // axis tried first, never the turnaround), then the current
        // heading, then a fixed detour scan, and only as a last resort
        // a turnaround. Leaves e->dir at dir.nodir when fully blocked
        // in.
        //
        // The detour scan is deliberately lopsided: it walks north →
        // northwest → west (or the reverse, 50/50) and never considers
        // east or south at all. That's the observed behavior of the
        // original — blocked enemies drift north/west and will take a
        // northwest diagonal, but never sidestep the other way — and
        // reproducing it keeps their pathing recognizably "Wolf3D".
        private let select_chase_dir = (lv: level*, g: game*, self_idx: i32) ->
            let e = &lv.enemies[self_idx]
            let dxi = (i32) g.pos_x - e.tile_x
            let dyi = (i32) g.pos_y - e.tile_y
            let adx = if dxi < 0 then -dxi else dxi
            let ady = if dyi < 0 then -dyi else dyi
            let old_dir = e.dir
            let turnaround = if old_dir == dir.nodir then dir.nodir else dir.opposite[old_dir]
            let mut d1 = dir.nodir
            let mut d2 = dir.nodir
            if dxi > 0 then d1 = dir.east else if dxi < 0 then d1 = dir.west
            if dyi > 0 then d2 = dir.south else if dyi < 0 then d2 = dir.north
            if ady > adx then
                let t = d1
                d1 = d2
                d2 = t
            if d1 == turnaround then d1 = dir.nodir
            if d2 == turnaround then d2 = dir.nodir
            if d1 != dir.nodir then
                e.dir = d1
                if try_enemy_walk(lv, g, self_idx, d1) then return
            if d2 != dir.nodir then
                e.dir = d2
                if try_enemy_walk(lv, g, self_idx, d2) then return
            if old_dir != dir.nodir && old_dir != turnaround then
                e.dir = old_dir
                if try_enemy_walk(lv, g, self_idx, old_dir) then return
            let scan = dir[3] { dir.north, dir.northwest, dir.west }
            let reversed = rnd_byte(g) <= 128
            for k in 0..3 do
                let d = scan[if reversed then 2 - k else k]
                if d == turnaround then continue
                e.dir = d
                if try_enemy_walk(lv, g, self_idx, d) then return
            if turnaround != dir.nodir then
                e.dir = turnaround
                if try_enemy_walk(lv, g, self_idx, turnaround) then return
            e.dir = dir.nodir

        // Dodge direction selector — used while the enemy can see the
        // player but chose not to fire this tick, and by dogs and the
        // fake Hitler always. Instead of heading straight in it
        // prefers the diagonal that closes on the player, then the
        // two closing cardinals with the SHORTER axis first (so the
        // approach sidesteps across the line of fire), the pair
        // shuffled 50/50, then the two retreating cardinals, and
        // reverses heading only as a last resort. The very first pick
        // after sighting may reverse freely — that's how a guard shot
        // from behind spins to face you.
        private let swap_dodge_slots = (cand: dir[]) ->
            let t1 = cand[1]
            cand[1] = cand[2]
            cand[2] = t1
            let t3 = cand[3]
            cand[3] = cand[4]
            cand[4] = t3

        private let select_dodge_dir = (lv: level*, g: game*, self_idx: i32) ->
            let e = &lv.enemies[self_idx]
            let free_turn = e.first_attack
            if free_turn then e.first_attack = false
            let turnaround = if free_turn || e.dir == dir.nodir then dir.nodir
                             else dir.opposite[e.dir]
            let dxi = (i32) g.pos_x - e.tile_x
            let dyi = (i32) g.pos_y - e.tile_y
            let adx = if dxi < 0 then -dxi else dxi
            let ady = if dyi < 0 then -dyi else dyi
            // Slots: 1 = closing x, 2 = closing y, 3 = retreating x,
            // 4 = retreating y; slot 0 is the closing diagonal.
            let cand = dir[5] { dir.nodir, dir.nodir, dir.nodir, dir.nodir, dir.nodir }
            if dxi > 0 then
                cand[1] = dir.east
                cand[3] = dir.west
            else
                cand[1] = dir.west
                cand[3] = dir.east
            if dyi > 0 then
                cand[2] = dir.south
                cand[4] = dir.north
            else
                cand[2] = dir.north
                cand[4] = dir.south
            if adx > ady then swap_dodge_slots(cand)
            if rnd_byte(g) < 128 then swap_dodge_slots(cand)
            cand[0] = diagonal_of(cand[1], cand[2])
            for k in 0..5 do
                let d = cand[k]
                if d == dir.nodir || d == turnaround then continue
                e.dir = d
                if try_enemy_walk(lv, g, self_idx, d) then return
            if turnaround != dir.nodir then
                e.dir = turnaround
                if try_enemy_walk(lv, g, self_idx, turnaround) then return
            e.dir = dir.nodir

        // How an actor picks its next tile when it needs a heading.
        enum move_mode =
            | patrol     // follow the current heading / floor arrows
            | chase      // straight pursuit
            | dodge      // zig-zag pursuit (has line of sight, didn't fire)
            | run        // kiting away from the player (projectile bosses inside four tiles)

        private let select_dir = (lv: level*, g: game*, self_idx: i32, mode: move_mode) ->
            match mode with
            | patrol -> select_path_dir(lv, g, self_idx)
            | chase  -> select_chase_dir(lv, g, self_idx)
            | dodge  -> select_dodge_dir(lv, g, self_idx)
            | run    -> select_run_dir(lv, g, self_idx)

        // Run-away selector — the projectile bosses (Schabbs,
        // Giftmacher, Fat Face) use it whenever they re-pick a heading
        // within four tiles of the player, so they kite instead of
        // closing. The two cardinals pointing away from the player,
        // longer axis first, then a cardinal scan in a random order;
        // no turnaround preference at all.
        private let select_run_dir = (lv: level*, g: game*, self_idx: i32) ->
            let e = &lv.enemies[self_idx]
            let dxi = (i32) g.pos_x - e.tile_x
            let dyi = (i32) g.pos_y - e.tile_y
            let adx = if dxi < 0 then -dxi else dxi
            let ady = if dyi < 0 then -dyi else dyi
            let mut d1 = if dxi < 0 then dir.east else dir.west
            let mut d2 = if dyi < 0 then dir.south else dir.north
            if ady > adx then
                let t = d1
                d1 = d2
                d2 = t
            e.dir = d1
            if try_enemy_walk(lv, g, self_idx, d1) then return
            e.dir = d2
            if try_enemy_walk(lv, g, self_idx, d2) then return
            let scan = dir[4] { dir.north, dir.northwest, dir.west, dir.southwest }
            let forward = rnd_byte(g) > 128
            for k in 0..4 do
                let d = scan[if forward then k else 3 - k]
                e.dir = d
                if try_enemy_walk(lv, g, self_idx, d) then return
            e.dir = dir.nodir

        // Patrol: keep walking in the current heading. If the current
        // tile carries a path-arrow marker (plane-1 90..97, pre-
        // baked into lv->path_arrows), snap to that direction first.
        // If the resulting move is blocked, stop — no wall-bounce
        // fallback. Matches the original's patrol direction logic.
        let select_path_dir = (lv: level*, g: game*, self_idx: i32) ->
            let e = &lv.enemies[self_idx]
            let arrow = (i32) lv.path_arrows[(i64) e.tile_x * 64 + (i64) e.tile_y]
            match enum_of(dir, arrow) with
            | some(a) -> if a != dir.nodir then e.dir = a else void()
            | none -> void()
            if e.dir == dir.nodir || !try_enemy_walk(lv, g, self_idx, e.dir) then
                e.dir = dir.nodir

        // True iff the actor is parked exactly on its tile center —
        // i.e. it has no step in progress. Positions only ever leave
        // the center along a committed heading and are snapped back
        // on arrival / door-wait, so exact comparison is right.
        private let at_tile_center = (e: const enemy*) ->
            e.x == (f64) e.tile_x + 0.5 && e.y == (f64) e.tile_y + 0.5

        // The tile this actor is heading for: the next tile along its
        // heading while a step is in progress, otherwise the one it
        // stands on. The fire decisions measure distance from here,
        // matching the original, whose actors "occupy" their
        // destination tile from the moment they commit to it.
        let dest_tile = (e: const enemy*) ->
            if e.dir != dir.nodir && !at_tile_center(e) then
                { e.tile_x + dir.dx[e.dir], e.tile_y + dir.dy[e.dir] }
            else
                { e.tile_x, e.tile_y }

        // Tiles left to travel along the current heading (per axis —
        // see advance_move). Zero when no step is in progress, i.e.
        // parked on a center: for the fire decisions "just arrived"
        // and "about to arrive" both count as there. The mover
        // computes its own remaining distance, since for it a heading
        // picked from a parked position has a whole tile to go.
        let step_remaining = (e: const enemy*) ->
            if e.dir == dir.nodir || at_tile_center(e) then 0.0
            else if dir.dx[e.dir] != 0 then math.abs((f64) (e.tile_x + dir.dx[e.dir]) + 0.5 - e.x)
            else math.abs((f64) (e.tile_y + dir.dy[e.dir]) + 0.5 - e.y)

        // Advance this enemy along its current direction by
        // `speed * dt` tiles. The budget is spent PER AXIS: a cardinal
        // step covers it along one axis, a diagonal step advances both
        // axes by the same amount and so covers √2 the ground — the
        // original's actors are faster on the diagonal, and dodging
        // enemies visibly are. When crossing a tile center, consumes
        // the leftover step by picking a new direction and continuing
        // — otherwise enemies would slow down noticeably at every grid
        // crossing. A new heading is also picked whenever the actor
        // is parked on a tile center at the top of a tick: that is
        // what turns a freshly woken standing guard's facing into a
        // real chase heading, and what lets an actor that was waiting
        // on a door reconsider once alerted. If the next tile is a
        // closed or animating door, kicks it to opening (with sound)
        // and pauses at the current tile center until it's fully open
        // — matches the original's chase-step door-open logic.
        // Would an actor at (nx, ny) be inside the one-tile box around
        // the player? Only counts while its room is connected to the
        // player's, as in the original.
        private let inside_player_box = (lv: level*, g: game*, e: enemy*, nx: f64, ny: f64) ->
            let area = (i32) lv.tile_areas[(i64) e.tile_x * 64 + (i64) e.tile_y]
            if area >= areas.num_areas || !lv.area_by_player[area] then false
            else
                let dx = nx - g.pos_x
                let dy = ny - g.pos_y
                dx >= -1.0 && dx <= 1.0 && dy >= -1.0 && dy <= 1.0

        let advance_move = (lv: level*, g: game*, ac: audio_ctx*, self_idx: i32, speed: f64, dt: f64, mode: move_mode, park_mode: move_mode) ->
            // Enemy Speed slider — scales every patrol + chase speed.
            // Applied here (the single chokepoint for all enemy
            // movement) so callers stay unaware. 100 = OG-faithful.
            let mut step = speed * dt * enemy_speed_factor(g)
            loop
                if step <= 1e-6 then break
                let e = &lv.enemies[self_idx]
                if e.waiting_door >= 0 then
                    // Parked in front of a door with the heading kept:
                    // keep asking for it every tick (an open door gets
                    // its hold timer reset, a closing one reverses) and
                    // walk on only once it stands fully open.
                    let dn = e.waiting_door
                    doors.actor_open(lv, dn, g, ac)
                    if lv.doors[dn].state != doors.door_state.open then break
                    e.waiting_door = -1
                else if e.dir == dir.nodir || at_tile_center(e) then
                    // A blocked-in actor's fresh pick uses the caller's
                    // park mode; a heading re-picked on reaching a tile
                    // centre uses the move mode (they differ only for
                    // the kiting bosses).
                    select_dir(lv, g, self_idx, if e.dir == dir.nodir then park_mode else mode)
                    if e.dir == dir.nodir then break
                let ntx = e.tile_x + dir.dx[e.dir]
                let nty = e.tile_y + dir.dy[e.dir]
                if ntx >= 0 && ntx < map_size && nty >= 0 && nty < map_size then
                    let nt = (i32) lv.tilemap[(i64) ntx * 64 + (i64) nty]
                    if nt >= 128 && lv.doors[nt - 128].state != doors.door_state.open then
                        if kind_opens_doors(e.kind) then
                            doors.actor_open(lv, nt - 128, g, ac)
                            e.x = (f64) e.tile_x + 0.5
                            e.y = (f64) e.tile_y + 0.5
                            e.waiting_door = nt - 128
                            break
                        else
                            // Door is a solid wall to this kind — abort
                            // the step and force a new direction choice
                            // from the current tile.
                            e.x = (f64) e.tile_x + 0.5
                            e.y = (f64) e.tile_y + 0.5
                            e.dir = dir.nodir
                            break
                // Per-axis distance to the next center — a full tile
                // when the heading was just picked from a parked
                // position (NOT step_remaining, which reads 0 there).
                let remaining = if dir.dx[e.dir] != 0 then math.abs((f64) ntx + 0.5 - e.x)
                                else math.abs((f64) nty + 0.5 - e.y)
                if step < remaining then
                    // The stand-off: a step that would land inside the
                    // one-tile box around the player (per axis, and
                    // only while the rooms are connected) is backed
                    // out — the actor marks time against you, and a
                    // ghost drains two points per tic while it does.
                    let nx = e.x + (f64) dir.dx[e.dir] * step
                    let ny = e.y + (f64) dir.dy[e.dir] * step
                    if inside_player_box(lv, g, e, nx, ny) then
                        if kind_is_ghost(e.kind) then
                            // Two points per tic. The original deals
                            // `2 × this frame's tics` each frame, an
                            // integer; banking the fraction keeps the
                            // rate at 140/s on every display.
                            e.ghost_drain = e.ghost_drain + dt * 70.0 * 2.0
                            let whole = (i32) math.floor(e.ghost_drain)
                            if whole > 0 then
                                e.ghost_drain = e.ghost_drain - (f64) whole
                                damage_player(g, ac, whole, damage_source.ghost, e.x, e.y)
                    else
                        e.x = nx
                        e.y = ny
                    step = 0.0
                else
                    e.x = (f64) ntx + 0.5
                    e.y = (f64) nty + 0.5
                    e.tile_x = ntx
                    e.tile_y = nty
                    step = step - remaining
                    // Parked on the new center: the loop head picks the
                    // next heading if any budget is left.

        // Advance the walk cycle: four poses plus the hold beats after
        // poses 1 and 3 (none for ghosts). Leftover time carries into
        // the next slot so the duty cycle stays exact at any tick
        // rate; `anim_frame` is always the pose (0..3) and
        // `walk_pause` says whether we're in a hold. Callers gate
        // movement and fire decisions on `!walk_pause`.
        private let step_walk_cycle = (e: enemy*, patrol: bool) ->
            loop
                if e.anim_timer > 0.0 then break
                if kind_is_ghost(e.kind) then
                    e.anim_frame = (e.anim_frame + 1) % 4
                    e.anim_timer = e.anim_timer + ghost_pose_time
                else if e.walk_pause then
                    e.walk_pause = false
                    e.anim_frame = (e.anim_frame + 1) % 4
                    e.anim_timer = e.anim_timer + (if patrol then patrol_pose_b_time else chase_pose_b_for_kind(e.kind))
                else if e.anim_frame == 0 || e.anim_frame == 2 then
                    e.walk_pause = true
                    e.anim_timer = e.anim_timer + (if patrol then patrol_hold_time else chase_hold_for_kind(e.kind))
                else
                    e.anim_frame = (e.anim_frame + 1) % 4
                    e.anim_timer = e.anim_timer + (if patrol then patrol_pose_a_time else chase_pose_a_for_kind(e.kind))

        // (Re)start the walk cycle from pose 1 with a full hold-free
        // beat ahead — every entry into chase does this.
        private let restart_walk_cycle = (e: enemy*) ->
            e.anim_frame = 0
            e.anim_timer = chase_pose_a_for_kind(e.kind)
            e.walk_pause = false

        // Player damage path — one place so every damage source routes
        // through the same SFX + death-transition handling. dmg ≤0 is
        // a no-op; damage while already dying / intermission / cutscene
        // is silently dropped so scripted paths can keep ticking
        // without retriggering the death transition.
        //
        // `kx`, `ky` are the attacker's world position at the moment
        // the hit lands — captured (alongside the latch on the
        // game struct) only when this hit is lethal, so the dying-
        // phase camera swings the heading toward who killed you.
        // Matches the original's death rotation; for projectile
        // hits we pass the projectile's own (x, y), as in the
        // original where the projectile object itself is what the
        // death-rotation reads, so the swing aims at the impact
        // point rather than the launcher.
        let damage_player = (g: game*, ac: audio_ctx*, dmg_in: i32, src: damage_source,
                             kx: f64, ky: f64) ->
            if dmg_in <= 0 then return
            match g.phase with
            | playing -> void()
            | _       -> return
            // "Can I Play Daddy" difficulty quarters incoming damage
            // (matches the original's >>2 shift on baby difficulty).
            let dmg = if g.difficulty == difficulty.baby then dmg_in >> 2 else dmg_in
            // God mode (the original's, and our IDDQD) keeps the
            // health but still takes the flash and the face grimace:
            // the hit registers, it just doesn't hurt.
            if g.god_mode then
                g.damage_count = g.damage_count + (f64) dmg
                g.face_count = 256.0
                return
            // After the baby shift a 1-3 point hit rounds to 0, same as
            // the original where health -= 0 is a silent no-op — no
            // flash either, since the original scales the flash by the
            // shifted points.
            if dmg <= 0 then return
            // Last-attacker latch for the dying-face renderer: only
            // the Schabbs needle swaps BJ's dead face for the mutant-BJ
            // pic. Every other damage source clears the latch so a
            // needle followed by a normal hit correctly reverts to the
            // standard dead-face pic.
            g.last_hit_needle = match src with
            | needle -> true
            | _      -> false
            g.health = g.health - dmg
            g.damage_count = g.damage_count + (f64) dmg
            // Force the next face roll to fire on the next
            // hud.update_face tick so the new health row is visible
            // immediately (the original forces a face refresh in its
            // ouch-face branch right after the damage hit).
            g.face_count = 256.0
            if g.health <= 0 then
                g.health = 0
                g.phase = game_phase.dying
                g.phase_timer = 0.0
                // Latch the swing target — see comment block above
                // damage_player's signature.
                g.killer_x = kx
                g.killer_y = ky
                g.killer_active = true
                sfx.trigger(sfx.id.player_death, ac)
            // No grunt on a survived hit: the original's damage routine
            // is silent (its take-damage sample is never triggered),
            // only the death cry plays.

        // Drop a pickup sprite at (x, y). Reuses empty sprite slots
        // from earlier pickups before growing the list — prevents the
        // array from hitting its cap just because the player has been
        // clearing rooms.
        private let add_dropped_item = (lv: level*, x: f64, y: f64, page: i32, it: pickups.item_kind) ->
            let mut slot = -1
            for i in 0..lv.num_sprites do
                if !lv.sprites[i].alive then
                    slot = i
                    break
            if slot < 0 then
                if lv.num_sprites >= tilemap.max_sprites then return
                slot = lv.num_sprites
                lv.num_sprites = lv.num_sprites + 1
            lv.sprites[slot] = tilemap.sprite_obj {
                x = x, y = y, shape_page = page, dist = 0.0,
                item_type = it, alive = true, blocks = false
            }

        // Pool of guard death screams. The original picks one of eight
        // at random for guard-class enemies so repeated kills don't
        // sound identical.
        private let guard_death_sounds = sfx.id[8] {
            sfx.id.death_1, sfx.id.death_2, sfx.id.death_3, sfx.id.death_4,
            sfx.id.death_5, sfx.id.death_7, sfx.id.death_8, sfx.id.death_9
            // death_1..9 without #6 — the original reserves #6 for
            // the tenth floor's easter egg (see death_scream_for_kind).
        }

        // Per-kind death vocal (matches the original's per-kind death
        // scream lookup). Ghosts (pacman) are silent. On a tenth floor
        // (the secret levels) any grunt or dog has a 1-in-256 chance
        // of the reserved sixth scream instead — the original's easter
        // egg, rolled before the guard's regular pick.
        let death_scream_for_kind = (k: enemy_kind, g: game*) ->
            let grunt = match k with
                | guard | officer | ss | mutant | dog -> true
                | _ -> false
            if grunt && g.level_num % episode.levels_per == 9 && rnd_byte(g) == 0 then
                return some(sfx.id.death_6)
            match k with
            | dog          -> some(sfx.id.dog_death)
            | ss           -> some(sfx.id.leben)        // "Mein Leben!"
            | officer      -> some(sfx.id.nein_sovass)
            | mutant       -> some(sfx.id.ahhhg)
            | guard        -> some(guard_death_sounds[rnd_byte(g) & 7])
            | hans         -> some(sfx.id.mutti)        // "Mutti!"
            | gretel       -> some(sfx.id.mein)
            | giftmacher   -> some(sfx.id.donner)
            | fat          -> some(sfx.id.rose)
            | schabbs      -> some(sfx.id.meingott)     // "Mein Gott!"
            | hitler_fake  -> some(sfx.id.hitlerha)
            | mecha_hitler -> some(sfx.id.scheist)
            | hitler       -> some(sfx.id.eva)
            | blinky | pinky | clyde | inky -> none(sfx.id)

        // Transition this enemy into die: play death sound, drop any
        // pickup they carry, and let the animation timer tick out the
        // die frames. Caller awards score separately so stand-level
        // test commands can invoke this without accidentally buffing
        // the player.
        // Mecha Hitler dies by cracking open — the real Hitler steps
        // out at the same position and fights on. Matches the
        // original's morph hook on the mecha's death frame: reuse
        // the actor slot, swap kind to `hitler`, reset HP to his
        // difficulty tier, and start him in chase state so there's no
        // LOS-wake delay before he opens fire. Kill counter and score
        // are *not* re-awarded here — those fired when the mech's HP
        // reached zero. Real Hitler's separate HP pool earns his own
        // score and kill-count bump when he drops.
        private let morph_mecha_to_hitler = (g: game*, e: enemy*) ->
            e.kind           = enemy_kind.hitler
            e.hp             = hp_for_kind(enemy_kind.hitler, g.difficulty)
            e.state          = enemy_state.chase
            restart_walk_cycle(e)
            // Heading carries over from the mech, as in the original.
            e.notified       = true
            e.reaction_timer = 0.0
            // The original spawns Real Hitler as a brand-new actor, so
            // his drawn flag starts clear even though the mech's was set.
            e.active         = false
            e.waiting_door   = -1
            e.scream_timer   = -1.0

        // The death vocal: boss lines play flat at full volume (the
        // original fires them unlocated), everyone else's is positioned.
        private let play_death_scream = (g: game*, ac: audio_ctx*, e: enemy*) ->
            match death_scream_for_kind(e.kind, g) with
            | some(snd) ->
                if kind_is_boss(e.kind) then sfx.trigger(snd, ac)
                else sfx.trigger_at(snd, ac, g, e.x, e.y)
            | none -> void()

        // One tick of the die sequence's timers: the pending death
        // vocal, then the frame step when the current slice expires
        // (anim_timer has already been decremented by the caller).
        // Real Hitler's first collapse frame ends with the slurp cue,
        // as in the original.
        private let advance_die = (g: game*, ac: audio_ctx*, e: enemy*, dt: f64) ->
            if e.scream_timer >= 0.0 then
                e.scream_timer = e.scream_timer - dt
                if e.scream_timer <= 0.0 then
                    e.scream_timer = -1.0
                    play_death_scream(g, ac, e)
            if e.anim_timer <= 0.0 then
                let sp = sprites_for_kind(e.kind)
                if e.anim_frame < 0 then
                    e.anim_frame = 0
                    e.anim_timer = e.anim_timer + sp.die_frame_time
                else
                    e.anim_frame = e.anim_frame + 1
                    if e.kind == enemy_kind.hitler && e.anim_frame == 1 then
                        sfx.trigger(sfx.id.slurpie, ac)
                    if e.anim_frame >= sp.num_die_frames then
                        // Mecha's "death" is really the armor cracking
                        // open to reveal Real Hitler — flip the actor
                        // in place rather than leaving a corpse.
                        match e.kind with
                        | mecha_hitler -> morph_mecha_to_hitler(g, e)
                        | _            -> e.state = enemy_state.dead
                    else
                        e.anim_timer = e.anim_timer + sp.die_frame_time

        // Seed the die sequence (state, first slice, vocal timer). Used
        // by the kill and by the death cam's replay.
        let begin_die_sequence = (e: enemy*) ->
            let sp = sprites_for_kind(e.kind)
            e.state = enemy_state.die
            e.dir = dir.nodir
            if sp.die_hold_time > 0.0 then
                e.anim_frame = -1
                e.anim_timer = sp.die_hold_time
            else
                e.anim_frame = 0
                e.anim_timer = sp.die_frame_time
            e.scream_timer = sp.scream_delay

        let kill_enemy = (lv: level*, g: game*, ac: audio_ctx*, e: enemy*, sprite_start: i32) ->
            // Mommy Mode's gore arm: snapshot whichever live sprite the enemy was
            // showing this tick (walk-angle, shoot-pose, pain frame —
            // whatever sprite_page would resolve to under the current
            // state) BEFORE we flip state to `die`, so the fade-out
            // shows the last living pose instead of the die_frames
            // (which are the gory ones, especially on bosses).
            if mommy.hides_gore(g.mommy_mode) then
                e.mommy_fade_page = sprite_page(e, g.pos_x, g.pos_y)
                e.mommy_fade_t = 0.0
            e.state = enemy_state.die
            e.dir = dir.nodir
            // The die sequence: an optional upright hold on the first
            // walk pose (death-cam bosses), then the die frames, then
            // the corpse pose. The vocal is timed to the end of the
            // original's first die state; Schabbs and Real Hitler also
            // scream the instant they drop (the original fires theirs
            // twice).
            begin_die_sequence(e)
            match e.kind with
            | schabbs | hitler -> play_death_scream(g, ac, e)
            | _ -> void()
            let drop = drop_for_kind(e.kind, g.best_weapon)
            match drop with
            | decoration -> void()
            | _ ->
                let shape = drop_shape_for_item(drop)
                add_dropped_item(lv, e.x, e.y, sprite_start + shape, drop)

        // Apply damage to an enemy. Always alerts them (matches the
        // original: a shot through the wall still puts the actor into
        // attack mode). If HP would drop to 0, transition to die and
        // award score. Score goes here so
        // unscripted hitscans can't bypass it.
        //
        // Sneak-attack rule: an actor that hasn't entered combat yet —
        // still standing or patrolling, including one counting down
        // its reaction delay — takes DOUBLE damage. That's the
        // original's reward for stealth: a pistol round drops an
        // unaware guard at range, and a knife in the back is a real
        // weapon. The first hit wakes the actor, so it only applies
        // once per enemy.
        //
        // `idx` is the enemy's position in lv->enemies — needed so the
        // death-cam cutscene can reference the corpse after
        // damage_enemy returns.
        let damage_enemy = (lv: level*, g: game*, ac: audio_ctx*, e: enemy*, idx: i32, dmg_in: i32, sprite_start: i32) ->
            match e.state with
            | die | dead -> return
            | _ -> void()
            let dmg = match e.state with
            | stand | path -> dmg_in * 2
            | _            -> dmg_in
            // Damaging an enemy also raises noise (the original sets
            // its made-noise flag up front in the damage routine).
            // This is what makes a knife hit wake nearby guards even
            // though the knife itself isn't loud — the victim's pain
            // shout is.
            g.made_noise = true
            e.hp = e.hp - dmg
            // The original can only land a hit on a drawn actor, and a
            // drawn actor is active; make that implication explicit so
            // scripted hits (killenemy / hurtenemy) behave the same.
            e.active = true
            if e.hp <= 0 then
                score.add(g, score_for_kind(e.kind), ac)
                g.kills = g.kills + 1
                // Schabbs / Giftmacher / Fat / real Hitler end the
                // episode via the death-cam cutscene (matches the
                // original's death-cam triggers). All other kinds —
                // including Hans and Gretel — just drop their gold key
                // (or pickup) and leave the player to walk out.
                if kind_has_death_cam(e.kind) then
                    death_cam.enter(lv, g, ac, e, idx, sprite_start)
                else
                    kill_enemy(lv, g, ac, e, sprite_start)
                // Hans / Gretel drop the key from kill_enemy via
                // drop_for_kind. player.update checks the exit tile on
                // every move and routes the BJ-runs cutscene from
                // there.
            else
                // Put non-active actors into combat mode before
                // anything else (matches the original: the damage
                // routine wakes the actor up front regardless of
                // kind). For regular enemies this chase state is about
                // to be overridden by the pain transition below, but
                // for bosses / dogs it's the only thing that wakes
                // them on a through-the-wall or sneak-attack shot.
                match e.state with
                | stand | path -> wake_enemy(g, e, ac)
                | _ -> void()
                // Pain flinch applies to guards / officers / SS /
                // mutants only. In the original, the damage routine
                // is a no-op for bosses and dogs — they keep their
                // current state (chase / shoot) and continue fighting
                // through sustained damage. That's why unloading the
                // chain gun into Hans doesn't stun-lock him. The two
                // pain poses alternate on the parity of the remaining
                // HP, and the heading (plus any step in progress)
                // survives the flinch — the actor resumes where it
                // left off.
                match e.kind with
                | guard | officer | ss | mutant ->
                    e.state = enemy_state.pain
                    e.anim_frame = if (e.hp & 1) != 0 then 0 else 1
                    e.anim_timer = pain_time
                | _ -> void()

        // Per-kind reaction delay (seconds) between first detection
        // and actual wake. Matches the original's per-kind sight-delay
        // table: values are in tics (70 Hz) in the original; we
        // convert to seconds. rnd_byte is drawn from rng_enemy so
        // scripted tests stay deterministic.
        private let reaction_delay_for_kind = (k: enemy_kind, g: game*) ->
            let tics = match k with
            | guard   -> 1 + rnd_byte(g) / 4    // 1..64 tics (≈0.014..0.914s)
            | officer -> 2                      // fixed 2 tics
            | mutant  -> 1 + rnd_byte(g) / 6    // 1..43 tics
            | ss      -> 1 + rnd_byte(g) / 6    // 1..43 tics
            | dog     -> 1 + rnd_byte(g) / 8    // 1..32 tics
            | hans | schabbs | gretel | giftmacher
            | fat | hitler_fake | mecha_hitler | hitler -> 1
            | blinky | pinky | clyde | inky -> 1
            (f64) tics / 70.0

        // True iff a stand / path enemy has detected the player this
        // frame. Mirrors the first-detection half of the original's
        // sight check: an enemy ignores the player unless its area is
        // reachable from the player by open doors (area_by_player).
        // Inside that connected zone, AMBUSH-flagged enemies still
        // need a literal LOS, but regular guards detect on either LOS
        // *or* a noise event (gun shot or pain scream) anywhere in
        // the connected zone — that's how firing in one room pulls
        // everyone in connected rooms toward you. Detection starts a
        // reaction-delay countdown in update_enemy; the actual
        // transition-to-chase doesn't happen until the timer elapses.
        // First sight clears the AMBUSH flag (matches the original):
        // once spotted by an ambusher, repeat detections behave like
        // a normal guard (sound or sight).
        private let should_wake = (lv: level*, g: game*, e: enemy*) ->
            let area = (i32) lv.tile_areas[(i64) e.tile_x * 64 + (i64) e.tile_y]
            if area >= areas.num_areas then false
            else if !lv.area_by_player[area] then false
            else if e.ambush then
                let seen = sees_player(lv, g, e)
                if seen then e.ambush = false
                seen
            else g.made_noise || sees_player(lv, g, e)

        // Wake up a sleeping (stand/path) enemy — the original's
        // first-sighting transition, reached either when the
        // reaction-delay countdown runs out or from a hit the actor
        // survives. Plays the per-kind alert vocal once per actor
        // (`notified`): a sneak-attack victim that lives shouts
        // "Halt!" just like one that spotted you, while a real Hitler
        // morphed out of the mech inherits the mech's alerted state
        // and stays quiet.
        private let wake_enemy = (g: game*, e: enemy*, ac: audio_ctx*) ->
            e.state = enemy_state.chase
            restart_walk_cycle(e)
            // The heading is kept: a standing guard's facing becomes
            // its "previous" direction, so its first straight-chase
            // pick treats a full reversal as the last resort (the
            // original's guards, alerted by noise from behind, first
            // step forward or sideways). The dodge selector's
            // first-attack exemption is what lets one that actually
            // SEES you spin around at once.
            e.first_attack = true
            if !e.notified then
                e.notified = true
                // First-sighting vocal (matches the original): one
                // vocal per kind played when the enemy enters combat.
                // Mutants are silent (no vocalization). Ghosts are
                // silent. Each boss has a signature line.
                let snd = match e.kind with
                | guard        -> some(sfx.id.halt)
                | officer      -> some(sfx.id.spion)       // "Spion!"
                | ss           -> some(sfx.id.schutzad)    // "Schutzstaffel!"
                | dog          -> some(sfx.id.dog_bark)
                | mutant       -> none(sfx.id)          // silent
                | hans         -> some(sfx.id.gutentag)    // "Guten Tag!"
                | gretel       -> some(sfx.id.kein)
                | giftmacher   -> some(sfx.id.eine)
                | fat          -> some(sfx.id.erlauben)
                | schabbs      -> some(sfx.id.schabbsha)
                | hitler_fake  -> some(sfx.id.tot_hund)
                | mecha_hitler -> some(sfx.id.die)
                | hitler       -> some(sfx.id.die)
                | blinky | pinky | clyde | inky -> none(sfx.id)    // silent
                // Boss lines play flat at full volume (the original
                // fires them as plain, unlocated sounds); the
                // rank-and-file shouts are positioned at the actor.
                match snd with
                | some(sn) ->
                    if kind_is_boss(e.kind) then sfx.trigger(sn, ac)
                    else sfx.trigger_at(sn, ac, g, e.x, e.y)
                | none -> void()

        // Enemy firing an attack at the player, called from the shoot
        // frames. Ports the original's distance-based hit chance and
        // damage roll. Hitchance picks one of four formulas based on
        // whether the player is running this frame and whether the
        // enemy was drawn last frame (visible):
        //   still + hidden   : 256 - dist*8
        //   still + visible  : 256 - dist*16  (player can see to dodge)
        //   running + hidden : 160 - dist*8
        //   running + visible: 160 - dist*16
        // SS and Hans apply a 2/3 distance discount before this
        // lookup — they're more accurate shooters. Other bosses fire
        // with their own actor class and do not get it.
        private let fire_at_player = (lv: level*, g: game*, ac: audio_ctx*, e: enemy*) ->
            // Per-kind firing sound — matches the original's shoot
            // switch. Gretel falls through to the default nazi-fire cue.
            let snd = match e.kind with
            | ss                      -> sfx.id.ss_fire
            | hans | mecha_hitler | hitler -> sfx.id.boss_fire
            | schabbs                 -> sfx.id.schabbs_throw
            | hitler_fake             -> sfx.id.flamethrower
            | giftmacher | fat        -> sfx.id.missile_fire
            | _                       -> sfx.id.nazi_fire
            // An actor whose room isn't connected to the player's, or
            // whose line is blocked, doesn't shoot at all — no report
            // either (the original bails before its sound switch).
            let area = (i32) lv.tile_areas[(i64) e.tile_x * 64 + (i64) e.tile_y]
            if area >= areas.num_areas || !lv.area_by_player[area] then return
            if !check_line_clear(lv, e.x, e.y, g.pos_x, g.pos_y) then return
            sfx.trigger_at(snd, ac, g, e.x, e.y)
            // Range is measured from the tile the actor is heading for
            // (it froze mid-step to shoot), like every other distance
            // the AI takes.
            let { dtx, dty } = dest_tile(e)
            let dxi = (i32) g.pos_x - dtx
            let dyi = (i32) g.pos_y - dty
            let adx = if dxi < 0 then -dxi else dxi
            let ady = if dyi < 0 then -dyi else dyi
            let dist_tiles = if adx > ady then adx else ady
            // Only SS and Hans get the 2/3 discount in the original
            // (Hans is the only enemy on the boss actor class that
            // qualifies); Schabbs / Gretel / Giftmacher / Fat /
            // Hitler(fake/real) use their own actor class and miss
            // the shortcut.
            let dist_adj = match e.kind with
            | ss | hans -> dist_tiles * 2 / 3
            | _         -> dist_tiles
            let base = if g.player_running then 160 else 256
            let falloff = if e.last_visible then 16 else 8
            let hitchance = base - dist_adj * falloff
            if rnd_byte(g) < hitchance then
                let roll = rnd_byte(g)
                let dmg = if dist_adj < 2 then roll / 4
                          else if dist_adj < 4 then roll / 8
                          else roll / 16
                damage_player(g, ac, dmg, damage_source.bullet, e.x, e.y)

        // Begin the attack cycle: first shoot pose, its hold time
        // scaled by the Enemy Speed slider.
        private let enter_shoot = (e: enemy*, g: game*) ->
            let sp = sprites_for_kind(e.kind)
            e.state = enemy_state.shoot
            e.anim_frame = 0
            e.anim_timer = sp.shoot_times[0] / enemy_speed_factor(g)

        // Chance (out of 256) that an actor with a clear line to the
        // player opens fire this tick. The original rolls once per
        // think against `this frame's tics × K` in integer arithmetic,
        // so the per-second rate wobbles with the frame rate; we take
        // the per-tic chance the reference one-tic frame gives (integer
        // division and all) and scale it by the real elapsed tics as a
        // fraction, so the rate is the same on every display — and by
        // the Enemy Speed slider so faster enemies really do fire more
        // often. Roll it with rnd_chance.
        //   Hitscan kinds : 16 / dist per tic, where dist is the tile
        //                   Chebyshev distance from the tile the actor
        //                   is heading for (see dest_tile). Point blank
        //                   it's a certainty: 300 once that tile IS the
        //                   player's, or is adjacent with under a
        //                   quarter tile left to walk. An enemy that
        //                   reaches you attacks on arrival, every time.
        //   Needle / rocket bosses : 8 per tic, range-independent.
        //   Fake Hitler   : 2 per tic, range-independent.
        private let fire_chance = (e: const enemy*, g: game*, dt: f64) ->
            let tics = dt * 70.0 * enemy_speed_factor(g)
            let per_tic = match e.kind with
            | schabbs | giftmacher | fat -> 8.0 * og_frame_tics
            | hitler_fake                -> 2.0 * og_frame_tics
            | _ ->
                let { dtx, dty } = dest_tile(e)
                let dxi = (i32) g.pos_x - dtx
                let dyi = (i32) g.pos_y - dty
                let adx = if dxi < 0 then -dxi else dxi
                let ady = if dyi < 0 then -dyi else dyi
                let dist = if adx > ady then adx else ady
                if dist == 0 || (dist == 1 && step_remaining(e) < 0.25) then 300.0
                else (f64) ((i32) (16.0 * og_frame_tics) / dist)
            if per_tic >= 256.0 then per_tic else per_tic * tics / og_frame_tics

        // Per-frame AI step for one enemy. Dispatches on state;
        // advances animation and moves continuously. Called from
        // update_enemies which does the loop.
        private let update_enemy = (lv: level*, g: game*, ac: audio_ctx*, self_idx: i32, dt: f64, sprite_start: i32) ->
            let e = &lv.enemies[self_idx]
            e.anim_timer = e.anim_timer - dt
            match e.state with
            | dead -> void()
            | die ->
                if mommy.hides_gore(g.mommy_mode) then
                    // Mommy Mode: skip the gory die_frames entirely.
                    // Hold on the cached last-live sprite and fade alpha
                    // 0 → 1 over mommy_fade_duration. Mecha still morphs
                    // to Real Hitler at the end so the boss fight chain
                    // continues identically.
                    e.mommy_fade_t = e.mommy_fade_t + dt / mommy_fade_duration
                    if e.mommy_fade_t >= 1.0 then
                        e.mommy_fade_t = 1.0
                        match e.kind with
                        | mecha_hitler -> morph_mecha_to_hitler(g, e)
                        | _            -> e.state = enemy_state.dead
                else
                    advance_die(g, ac, e, dt)
            | pain ->
                if e.anim_timer <= 0.0 then
                    e.state = enemy_state.chase
                    restart_walk_cycle(e)
            | stand ->
                // Two-phase wake (matches the original): on first
                // detection we seed a per-kind reaction timer and keep
                // standing; the transition to chase only fires when
                // the timer counts down to 0. Commits on detection —
                // losing LOS mid-countdown doesn't abort the wake,
                // matching the original's "once spotted, reacting"
                // behavior.
                if e.reaction_timer > 0.0 then
                    e.reaction_timer = e.reaction_timer - dt
                    if e.reaction_timer <= 0.0 then
                        e.reaction_timer = 0.0
                        wake_enemy(g, e, ac)
                else if should_wake(lv, g, e) then
                    e.reaction_timer = reaction_delay_for_kind(e.kind, g)
            | path ->
                // Walk-cycle bookkeeping first. A hold beat freezes the
                // actor entirely — no step, and no looking for the
                // player either, so a patroller's reaction countdown
                // only runs while it's actually walking.
                step_walk_cycle(e, true)
                if e.walk_pause then return
                // Only the tick that actually wakes the actor skips
                // the patrol step. The detection tick (reaction timer
                // just seeded) and every countdown tick still walk —
                // the original's path think only bails once the
                // sighting completes.
                let woke =
                    if e.reaction_timer > 0.0 then
                        e.reaction_timer = e.reaction_timer - dt
                        if e.reaction_timer <= 0.0 then
                            e.reaction_timer = 0.0
                            wake_enemy(g, e, ac)
                            true
                        else false
                    else
                        if should_wake(lv, g, e) then
                            e.reaction_timer = reaction_delay_for_kind(e.kind, g)
                        false
                if !woke then
                    advance_move(lv, g, ac, self_idx, patrol_speed_for_kind(e.kind), dt, move_mode.patrol, move_mode.patrol)
            | chase ->
                // Walk-cycle bookkeeping first, then the think. During a
                // hold beat the actor stands still and doesn't consider
                // attacking — that stutter is the original's gait, not
                // a hitch (see the walk-cycle constants).
                let prev_pause = e.walk_pause
                step_walk_cycle(e, false)
                // Mech stomps: the cue is the original's end-of-frame
                // hook on the mech's first and third walk poses, so it
                // fires as those poses give way to their hold beats —
                // and only while the mech's room is connected to the
                // player's.
                match e.kind with
                | mecha_hitler ->
                    if !prev_pause && e.walk_pause then
                        let area = (i32) lv.tile_areas[(i64) e.tile_x * 64 + (i64) e.tile_y]
                        if area < areas.num_areas && lv.area_by_player[area] then
                            sfx.trigger_at(sfx.id.mech_step, ac, g, e.x, e.y)
                | _ -> void()
                if e.walk_pause then return
                match e.kind with
                | dog ->
                    // Dog lunge gate (matches the original): |dx|-move ≤ 1
                    // && |dy|-move ≤ 1 in tiles, and NO line-of-sight
                    // requirement — a dog that close bites around the
                    // corner. `move` is the dog's distance-to-travel
                    // this frame, so the effective range is 1 + step on
                    // each axis. Step here mirrors the per-frame distance
                    // advance_move would compute, so the Enemy Speed
                    // slider scales the lunge range too — otherwise a
                    // sped-up dog would walk further per tick than its
                    // lunge gate believes.
                    let step = dog_chase_speed * dt * enemy_speed_factor(g)
                    let adx = math.abs(g.pos_x - e.x)
                    let ady = math.abs(g.pos_y - e.y)
                    if adx <= 1.0 + step && ady <= 1.0 + step then
                        enter_shoot(e, g)
                    else
                        // Dogs always weave in rather than charging
                        // straight.
                        advance_move(lv, g, ac, self_idx, dog_chase_speed, dt, move_mode.dodge, move_mode.dodge)
                | blinky | pinky | clyde | inky ->
                    // Pacman ghosts — chase silently; no shoot
                    // animation, no projectile. The damage is the
                    // original's stand-off rule in advance_move: a
                    // ghost whose step would land inside the one-tile
                    // box around the player is held back and drains
                    // two points per tic instead.
                    advance_move(lv, g, ac, self_idx, chase_speed_for_kind(e.kind), dt, move_mode.chase, move_mode.chase)
                | _ ->
                    // With a clear line to the player, roll to open
                    // fire (see fire_chance). An actor that could have
                    // fired but didn't switches to the dodging
                    // approach for this tick's movement; without a line
                    // it pursues straight. The fake Hitler weaves
                    // regardless.
                    let mut dodge = false
                    if check_line_clear(lv, e.x, e.y, g.pos_x, g.pos_y) then
                        if rnd_chance(g, fire_chance(e, g, dt)) then
                            enter_shoot(e, g)
                            return
                        dodge = true
                    let park_mode = if dodge || e.kind == enemy_kind.hitler_fake then move_mode.dodge
                                    else move_mode.chase
                    // The projectile bosses kite: inside four tiles
                    // (Chebyshev, from the tile they're heading for)
                    // every heading re-picked at a tile centre runs
                    // away — only a blocked-in actor's fresh pick
                    // still uses the dodge / chase rule.
                    let mode = match e.kind with
                        | schabbs | giftmacher | fat ->
                            let { dtx, dty } = dest_tile(e)
                            let dxi = (i32) g.pos_x - dtx
                            let dyi = (i32) g.pos_y - dty
                            let adx = if dxi < 0 then -dxi else dxi
                            let ady = if dyi < 0 then -dyi else dyi
                            if (if adx > ady then adx else ady) < 4 then move_mode.run else park_mode
                        | _ -> park_mode
                    advance_move(lv, g, ac, self_idx, chase_speed_for_kind(e.kind), dt, mode, park_mode)
            | shoot ->
                let sp = sprites_for_kind(e.kind)
                if e.anim_timer <= 0.0 then
                    // Fire at end of current state, BEFORE advancing.
                    // The original's actor stepper runs each state's
                    // action callback when its timer expires and only
                    // then transitions to the next state, so mask bit
                    // N means "fire when state N's timer expires" —
                    // putting damage on the same tick the next state's
                    // sprite (e.g. the SHOOT3 muzzle flash following a
                    // SHOOT2 windup) first becomes visible.
                    let mask = shoot_fire_mask_for_kind(e.kind)
                    if (mask & (1 << e.anim_frame)) != 0 then
                        match e.kind with
                        | dog -> projectiles.enemy_bite_player(lv, g, ac, e)
                        | schabbs | giftmacher | hitler_fake ->
                            projectiles.spawn(lv, ac, g, e, projectiles.kind_for_enemy(e.kind))
                        | fat ->
                            // Fat opens with a rocket on frame 1 and
                            // follows up with four chaingun bullets on
                            // frames 2-5 — mixed attack types within a
                            // single state cycle in the original.
                            if e.anim_frame == 1 then
                                projectiles.spawn(lv, ac, g, e, projectiles.kind_for_enemy(e.kind))
                            else
                                fire_at_player(lv, g, ac, e)
                        | _   -> fire_at_player(lv, g, ac, e)
                    e.anim_frame = e.anim_frame + 1
                    if e.anim_frame >= sp.num_shoot_frames then
                        // Back to chase with heading and any half-taken
                        // step intact — the attack was an interruption,
                        // not a reset.
                        e.state = enemy_state.chase
                        restart_walk_cycle(e)
                        return
                    e.anim_timer = sp.shoot_times[e.anim_frame] / enemy_speed_factor(g)

        // Sprite projection cutoffs (tiles): the shape is nudged a
        // quarter tile toward the camera before projecting so its edges
        // don't poke into an adjacent wall, and anything nearer than the
        // player radius after that isn't projected at all.
        private let actor_shape_fudge = 0.25
        private let min_draw_depth = 0.34375

        // Was the actor's tile, or a neighbouring floor tile, touched by
        // this tick's view rays? The original's nine-tile test: a
        // neighbour only counts if it's open floor (walls and doors
        // don't let a sprite show through).
        private let tile_spotted = (lv: level*, tx: i32, ty: i32) ->
            let in_map = (x: i32, y: i32) ->
                x >= 0 && x < map_size && y >= 0 && y < map_size
            let spotted = (x: i32, y: i32) ->
                in_map(x, y) && lv.vis_tiles[(i64) x * 64 + (i64) y]
            let open_floor = (x: i32, y: i32) ->
                in_map(x, y) && lv.tilemap[(i64) x * 64 + (i64) y] == 0u8
            if spotted(tx, ty) then true
            else
                let mut hit = false
                for oy in -1..2 do
                    for ox in -1..2 do
                        if (ox != 0 || oy != 0) && !hit then
                            let nx = tx + ox
                            let ny = ty + oy
                            if spotted(nx, ny) && open_floor(nx, ny) then hit = true
                hit

        let update_enemies = (w: world*, dt: f64) ->
            let sprite_start = w.ac.vs.sprite_start
            let lv = w.lv
            for i in 0..lv.num_enemies do
                // The original's per-actor think gate: an actor that has
                // never been drawn and whose area isn't reachable from
                // the player through open doors is skipped outright —
                // no sight check, no reaction countdown, no chase step,
                // no animation. That's why a guard woken by a gunshot
                // through a doorway freezes in place if the door shuts
                // before he's ever been on screen, and only resumes when
                // a door reconnects the rooms. Patrollers spawn active,
                // so this only ever bites standing spawns (and bosses).
                let e = &lv.enemies[i]
                if !e.active then
                    let area = (i32) lv.tile_areas[(i64) e.tile_x * 64 + (i64) e.tile_y]
                    if area >= areas.num_areas || !lv.area_by_player[area] then continue
                update_enemy(lv, w.g, w.ac, i, dt, sprite_start)
            // Refresh the two "drawn" flags for the next tick. Mirrors
            // the original's end-of-frame sprite pass, which runs after
            // every actor has moved and whose results the shoot logic
            // reads on the following tic: the wall rays mark every tile
            // they touch (tilemap.mark_visible_tiles rebuilds that grid
            // here, since --test mode never renders), and an actor is
            // considered when its own tile or any of the eight
            // neighbouring floor tiles (not walls, not doors) was
            // touched. That alone makes it `active` for good. It is
            // actually on screen (`last_visible`, the steeper hitchance
            // falloff) only if it's also far enough in front of the
            // camera for the sprite to be projected: depth minus the
            // quarter-tile shape fudge must reach the minimum draw
            // distance — and one too close to project keeps last
            // frame's flag rather than clearing it (the original's
            // sprite pass skips it before either branch).
            let g = w.g
            tilemap.mark_visible_tiles(lv, g, w.rc.fb_w)
            let inv_det = 1.0 / (g.plane_x * g.dir_y - g.dir_x * g.plane_y)
            for i in 0..lv.num_enemies do
                let e = &lv.enemies[i]
                let touched = tile_spotted(lv, e.tile_x, e.tile_y)
                if touched then e.active = true
                let dx = e.x - g.pos_x
                let dy = e.y - g.pos_y
                let depth = inv_det * (g.plane_x * dy - g.plane_y * dx)
                if !touched then e.last_visible = false
                else if depth - actor_shape_fudge >= min_draw_depth then e.last_visible = true

        // Animation-only pump for actors in die. Used during phases
        // that freeze the rest of gameplay (bj_victory, the
        // elevator pre-tally freeze) so a boss dying at the tail end
        // of a fight still plays its full die-frame cascade and lands
        // on the dead-pose sprite instead of staying stuck on its
        // first die frame.
        let update_dying_enemies = (lv: level*, g: game*, ac: audio_ctx*, dt: f64) ->
            for i in 0..lv.num_enemies do
                let e = &lv.enemies[i]
                match e.state with
                | die ->
                    e.anim_timer = e.anim_timer - dt
                    advance_die(g, ac, e, dt)
                | _ -> void()


// ============================================================
// Enemy projectile attacks — visible dodgeable objects fired by Schabbs,
// Giftmacher, Fat, and fake Hitler. Matches the original's per-boss
// throw/launch spawn paths plus the shared per-tic projectile step.
// ============================================================

module projectiles =
    import math from std::

    enum projectile_kind =
        | needle    // Schabbs syringe: 4-frame flip-book, non-rotating
        | rocket    // Giftmacher / Fat missile: 8 rotating angles, explodes
        | fire      // Fake Hitler flamethrower: 2-frame animation, dissipates
        | boom      // Short-lived explosion sprite spawned on rocket wall hit
        | smoke     // Inert puff the rocket leaves behind every 3 tics (4 frames)

    struct projectile =
        kind: projectile_kind
        x: f64
        y: f64
        angle: f64            // radians, direction of travel
        alive: bool           // false = slot is free
        anim_frame: i32       // cycling 0..3 for needle, 0..1 for fire, 0..2 for boom, 0..3 for smoke
        anim_timer: f64       // seconds until next frame
        smoke_timer: f64      // rocket only: seconds until the next puff

    let max_projectiles = 32   // generous cap — the original shares actor slots; few projectiles actually fly at once

    // Projectile speeds in tiles/sec, derived from the original's
    // fixed-point 0x2000 (needle/rocket) and 0x1200 (flame) per-tic
    // speeds at the 70Hz tic rate.
    private let needle_speed = 8.75   // 0x2000 * 70 / 0x10000
    private let rocket_speed = 8.75
    let fire_speed   = 4.92   // 0x1200 * 70 / 0x10000
    let hit_radius   = 0.75   // per-axis player hit box (tile units)
    let wall_radius  = 0.125  // wall collision half-extent (tile units)
    // Frame times from the original's projectile states: needle and
    // flame 6 tics, explosion 6 tics, smoke 3 tics (the first puff
    // frame shows for 6), a puff every 3 tics of rocket flight.
    let anim_time    = 6.0 / 70.0
    let boom_time    = 6.0 / 70.0
    // A fresh flame is dealt a one-tic first frame, so its first
    // step (and first hit test) comes almost at once; the six-tic
    // cadence starts after that.
    let fire_first   = 1.0 / 70.0
    let smoke_time   = 3.0 / 70.0
    let smoke_first  = 6.0 / 70.0
    let smoke_period = 3.0 / 70.0

    // Sprite-page offsets into VSWAP (relative to `sprite_start`).
    // Derived from the original's sprite layout: needle at 317, fire
    // at 326, rocket/smoke/boom block at 370/378/382.
    let hypo_base   = 317
    let fire_base   = 326
    private let rocket_base = 370
    private let smoke_base  = 378
    let boom_base   = 382

    // Angle wrap helper. Keeps `a` in [0, 2π).
    private let tau = 6.283185307179586

    private let wrap_angle = (a: f64) ->
        let mut r = a
        loop
            if r >= 0.0 then break
            r = r + tau
        loop
            if r < tau then break
            r = r - tau
        r

    // VSWAP page for a projectile in its current state. The rocket is
    // a rotating sprite like an actor: its eight views are picked from
    // its heading relative to the line back to the viewer, so one
    // flying at you shows its nose and one crossing your view its
    // side (same rule as the enemies' eight-way sprites — the
    // original approximates that line from the sprite's screen
    // column, we use the exact vector). Needle/fire/boom/smoke use
    // sequential frames from their base pages.
    let sprite_page = (sprite_start: i32, p: projectile*, px: f64, py: f64) ->
        match p.kind with
        | needle -> sprite_start + hypo_base + (p.anim_frame & 3)
        | rocket ->
            let to_viewer = math.atan2(p.y - py, px - p.x)   // y-up, like p.angle
            let rel = wrap_angle(to_viewer - p.angle + math.pi / 8.0)
            let mut idx = (i32) (rel * 8.0 / tau)
            if idx < 0 then idx = 0
            if idx > 7 then idx = 7
            sprite_start + rocket_base + idx
        | fire -> sprite_start + fire_base + (p.anim_frame & 1)
        | smoke -> sprite_start + smoke_base + (if p.anim_frame > 3 then 3 else p.anim_frame)
        | boom ->
            let f = if p.anim_frame > 2 then 2 else p.anim_frame
            sprite_start + boom_base + f

    // Find a free projectile slot, or -1 if the array is saturated.
    // Callers silently drop the spawn when full (matches the
    // original's actor-cap guard).
    private let alloc_slot = (lv: level*) ->
        let mut slot = -1
        for i in 0..max_projectiles do
            if slot < 0 && !lv.projectiles[i].alive then slot = i
        slot

    // Spawn a projectile at the enemy's current position, pointed at
    // the player's current position. Angle is stored in standard-trig
    // y-up convention so the rotating-rocket sprite picker can share
    // the same convention as enemies.angle_sprite.
    // An inert smoke puff at (x, y): four 3-tic frames (the first held
    // for 6), no movement, no damage.
    private let spawn_smoke = (lv: level*, x: f64, y: f64) ->
        let slot = alloc_slot(lv)
        if slot < 0 then return
        lv.projectiles[slot] = projectile {
            kind = projectile_kind.smoke,
            x = x,
            y = y,
            angle = 0.0,
            alive = true,
            anim_frame = 0,
            anim_timer = smoke_first,
            smoke_timer = 0.0
        }

    let spawn = (lv: level*, ac: audio_ctx*, g: game*, e: enemies.enemy*, k: projectile_kind) ->
        let slot = alloc_slot(lv)
        if slot < 0 then return
        let dx = g.pos_x - e.x
        let dy = e.y - g.pos_y     // flip to y-up so atan2 gives standard trig angle
        let ang = math.atan2(dy, dx)
        lv.projectiles[slot] = projectile {
            kind = k,
            x = e.x,
            y = e.y,
            angle = wrap_angle(ang),
            alive = true,
            anim_frame = 0,
            anim_timer = if k == projectile_kind.fire then fire_first else anim_time,
            smoke_timer = smoke_period
        }
        let snd = match k with
        | needle -> some(sfx.id.schabbs_throw)
        | rocket -> some(sfx.id.missile_fire)
        | fire   -> some(sfx.id.flamethrower)
        | boom | smoke -> none(sfx.id)
        match snd with
        | some(sn) -> sfx.trigger_at(sn, ac, g, e.x, e.y)
        | none -> void()

    // Wall / closed-door collision for a projectile point at (x, y).
    // Matches the original's 3x3 tile scan within the projectile
    // radius. Returns true if any tile in the scanned range blocks —
    // walls (1..63) and door tiles that aren't fully open.
    private let hits_wall = (lv: level*, x: f64, y: f64) ->
        let xl = (i32) math.floor(x - wall_radius)
        let yl = (i32) math.floor(y - wall_radius)
        let xh = (i32) math.floor(x + wall_radius)
        let yh = (i32) math.floor(y + wall_radius)
        let mut hit = false
        for tx in xl..(xh + 1) do
            for ty in yl..(yh + 1) do
                if tx < 0 || tx >= map_size || ty < 0 || ty >= map_size then
                    hit = true
                else
                    let t = (i32) lv.tilemap[(i64) tx * 64 + (i64) ty]
                    if t >= 1 && t <= 63 then hit = true
                    if t >= 128 then
                        let door_idx = t - 128
                        // A door is solid to a projectile unless it
                        // stands fully open (the original's door tile
                        // is only cleared at full open, and re-solid
                        // the instant it starts closing).
                        if door_idx >= 0 && door_idx < lv.num_doors
                            && lv.doors[door_idx].state != doors.door_state.open then hit = true
        hit

    // Damage per projectile kind — matches the original's per-class
    // damage rolls.
    private let damage_of = (k: projectile_kind, g: game*) ->
        let roll = enemies.rnd_byte(g)
        match k with
        | needle -> (roll >> 3) + 20    // 20-51
        | rocket -> (roll >> 3) + 30    // 30-61
        | fire   -> roll >> 3           // 0-31
        | boom | smoke -> 0

    // Per-frame update for one projectile slot. Advances animation,
    // steps the position, checks wall/player collision, mutates into
    // a boom sprite on rocket wall-hit, or frees the slot on other
    // terminal events.
    let update = (lv: level*, g: game*, ac: audio_ctx*, p: projectile*, dt: f64) ->
        if !p.alive then return
        let frame_time = match p.kind with
        | boom  -> boom_time
        | smoke -> smoke_time
        | _     -> anim_time
        p.anim_timer = p.anim_timer - dt
        let mut frame_rolled = false
        if p.anim_timer <= 0.0 then
            p.anim_frame = p.anim_frame + 1
            p.anim_timer = p.anim_timer + frame_time
            frame_rolled = true
        match p.kind with
        | boom ->
            // Short 3-frame explosion, then free the slot.
            if p.anim_frame >= 3 then p.alive = false
        | smoke ->
            if p.anim_frame >= 4 then p.alive = false
        | _ ->
            // The flame is the odd one out: its move hook is the
            // end-of-frame action, not the per-frame think, so it
            // only advances when a 6-tic frame rolls over — by one
            // frame's worth of travel — and only tests for a hit
            // then. That's the slow, dodgeable puff the original has,
            // and it makes the flame's pace frame-rate dependent on
            // DOS: a fast machine (one tic per frame) has it at 0.82
            // tiles/s, a slow 386 nearer 3. We step it by the
            // reference frame (`og_frame_dt`, one tic) whatever the
            // real frame length, so it's the fast machine's pace on
            // every display.
            if p.kind == projectile_kind.fire && !frame_rolled then return
            let speed = match p.kind with
            | needle -> needle_speed
            | rocket -> rocket_speed
            | fire   -> fire_speed
            | boom | smoke -> 0.0
            let step_dt = if p.kind == projectile_kind.fire then og_frame_dt else dt
            let step = speed * step_dt
            if p.kind == projectile_kind.rocket then
                // Smoke trail: a puff at the rocket's position every
                // 3 tics of flight.
                p.smoke_timer = p.smoke_timer - dt
                if p.smoke_timer <= 0.0 then
                    p.smoke_timer = p.smoke_timer + smoke_period
                    spawn_smoke(lv, p.x, p.y)
            // Y-up angle → y-down world motion: flip the sin term.
            let nx = p.x + math.cos(p.angle) * step
            let ny = p.y - math.sin(p.angle) * step
            if hits_wall(lv, nx, ny) then
                match p.kind with
                | rocket ->
                    // Mutate the slot into a short-lived explosion
                    // sprite at the last pre-hit position, so the
                    // fireball appears against the wall rather than
                    // inside it.
                    p.kind = projectile_kind.boom
                    p.anim_frame = 0
                    p.anim_timer = boom_time
                    sfx.trigger_at(sfx.id.missile_hit, ac, g, p.x, p.y)
                | _ -> p.alive = false
            else
                p.x = nx
                p.y = ny
                if math.abs(p.x - g.pos_x) < hit_radius
                    && math.abs(p.y - g.pos_y) < hit_radius then
                    let src = match p.kind with
                    | needle -> enemies.damage_source.needle
                    | rocket -> enemies.damage_source.rocket
                    | fire   -> enemies.damage_source.flame
                    | boom | smoke -> enemies.damage_source.rocket   // unreachable — neither damages the player
                    enemies.ai.damage_player(g, ac, damage_of(p.kind, g), src, p.x, p.y)
                    p.alive = false

    let update_all = (lv: level*, g: game*, ac: audio_ctx*, dt: f64) ->
        for i in 0..max_projectiles do
            update(lv, g, ac, &lv.projectiles[i], dt)

    // True iff this enemy kind fires a visible, dodgeable projectile
    // instead of using hitscan. Checked in the shoot dispatch.
    private let kind_uses_projectile = (k: enemies.enemy_kind) ->
        match k with
        | schabbs | giftmacher | fat | hitler_fake -> true
        | _ -> false

    // The projectile kind this enemy fires. Call only when
    // kind_uses_projectile is true.
    let kind_for_enemy = (k: enemies.enemy_kind) ->
        match k with
        | schabbs      -> projectile_kind.needle
        | giftmacher   -> projectile_kind.rocket
        | fat          -> projectile_kind.rocket
        | hitler_fake  -> projectile_kind.fire
        | _            -> projectile_kind.needle  // unreachable

    // Dog melee bite — called from the jump-frame of `shoot` for dog.
    // Damage is a flat ~0..16 roll inside melee range. The bark/snarl
    // plays unconditionally at the top of the frame (matches the
    // original) so the lunge is audible even when the dog misses.
    let enemy_bite_player = (lv: level*, g: game*, ac: audio_ctx*, e: enemies.enemy*) ->
        sfx.trigger_at(sfx.id.dog_attack, ac, g, e.x, e.y)
        let dx = g.pos_x - e.x
        let dy = g.pos_y - e.y
        // Per-axis box matching the original's bite check: each axis
        // must be within 2 tiles of the player center (|dx|-1 ≤ 1
        // after the original's tile-unit subtraction). This is more
        // permissive on diagonals than a euclidean check — a dog
        // centered on the tile-corner opposite the player at (1.9, 1.9)
        // still lands a bite.
        if math.abs(dx) > 2.0 || math.abs(dy) > 2.0 then return
        // No line-of-sight gate: inside that box the bite lands around
        // a corner too, as in the original.
        if enemies.rnd_byte(g) < 180 then
            // Matches the original's bite roll: random byte >> 4
            // → 0-15 (can graze for 0).
            let dmg = enemies.rnd_byte(g) >> 4
            enemies.ai.damage_player(g, ac, dmg, enemies.damage_source.bite, e.x, e.y)


// ============================================================
// Player-fire hitscan — called when Ctrl fires the weapon and there's a
// chance to hit an enemy. Ray is along player->dir; we pick the nearest
// live enemy within a small angular slice, then verify no wall is between.
// ============================================================

module hitscan =
    import math from std::

    // Aim window. A target is "under the crosshair" when its projected
    // screen position lies within a tenth of the view width of center.
    // That's an angular test, so a distant target gets a wider lateral
    // tolerance than a near one — at ten tiles you can be well over a
    // tile off and still connect (the distance miss roll below is what
    // makes long shots chancy, not aim), while at one tile you need the
    // central half of the sprite. In world terms: |lateral| < tan · depth
    // with tan = 32/218.75 ≈ 0.146 (a 320-wide view, but the ratio is
    // resolution-free), and `depth` is the sprite's projection depth,
    // which the renderer pulls a quarter tile toward the camera so shapes
    // don't sink into walls. A shape pulled nearer than the minimum draw
    // depth isn't projected at all, and so can't be hit — unreachable in
    // play, since actors hold a one-tile stand-off from the player.
    private let aim_half_tan      = 0.1463
    private let sprite_depth_pull = 0.25
    private let aim_min_depth     = 0.34375

    // Sprite depth along the view axis, as the weapons see it.
    private let target_depth = (g: game*, e: const enemies.enemy*) ->
        (e.x - g.pos_x) * g.dir_x + (e.y - g.pos_y) * g.dir_y - sprite_depth_pull

    // Return the index of the enemy under the crosshair, or -1: the
    // nearest shootable enemy inside the aim window. The wall check is
    // the caller's, done once on that enemy — a nearer target that
    // turns out to be behind a wall soaks the shot; it doesn't fall
    // through to the next one.
    private let find_hit_enemy = (lv: level*, g: game*) ->
        let mut best_idx = -1
        let mut best_depth = 1e6
        for i in 0..lv.num_enemies do
            let e = &lv.enemies[i]
            match e.state with
            | dead | die -> continue
            | _ -> void()
            // Pacman ghosts have no shootable flag in the original — bullets
            // and knife pass through them entirely.
            if enemies.kind_is_ghost(e.kind) then continue
            let depth = target_depth(g, e)
            if depth <= 0.1 - sprite_depth_pull || depth >= best_depth then continue
            let rx = e.x - g.pos_x
            let ry = e.y - g.pos_y
            let perp = rx * g.dir_y - ry * g.dir_x
            if depth < aim_min_depth then continue
            let win_depth = depth
            if math.abs(perp) >= aim_half_tan * win_depth then continue
            best_idx = i
            best_depth = depth
        best_idx

    // Per-weapon damage. Matches the original game's knife/gun
    // damage rolls, using our PCG `rnd_byte` (0-255) in place of the
    // original's random source. `depth` is the target's sprite depth
    // (see target_depth; used only for the knife reach gate — the
    // knife connects up to 1.5 tiles of it). `tile_dist` is the
    // Chebyshev (max-axis) distance in tile units, which is what the
    // gun damage bands key off.
    private let weapon_damage_roll = (g: game*, wp: weapon, depth: f64, tile_dist: i32) ->
        if wp == weapon.knife then
            // Knife — flat roll within melee reach, zero beyond.
            if depth > 1.5 then 0
            else enemies.rnd_byte(g) >> 4   // 0-15
        else
            // Firearms — three damage bands by tile Chebyshev distance,
            // with a long-range miss gate beyond 4 tiles.
            if tile_dist < 2 then enemies.rnd_byte(g) / 4         // 0-63
            else if tile_dist < 4 then enemies.rnd_byte(g) / 6    // 0-42
            else
                // Miss roll first, then damage. The miss check scales
                // with distance so farther targets eat more shots to
                // drop. Two separate byte rolls here mirror the two
                // random-byte draws in the original's long-range branch.
                if (enemies.rnd_byte(g) / 12) < tile_dist then 0
                else enemies.rnd_byte(g) / 6                      // 0-42

    // Called from player.update_weapon when the player actually fires (not
    // every frame, only on trigger-pull that spends a bullet). Finds
    // a target, applies damage, potentially kills the enemy (handled
    // inside ai.damage_enemy).
    let fire_player = (w: world*) ->
        let lv = w.lv
        let g = w.g
        let ac = w.ac
        // The original's gun attack sets the made-noise flag at the
        // top regardless of hit; the knife attack does NOT — knife is
        // a stealth weapon, only registering as noise (via
        // ai.damage_enemy below) when it actually connects. So gate
        // on weapon > 0 here, and let ai.damage_enemy cover the
        // knife-hit case.
        if g.weapon > weapon.knife then g.made_noise = true
        let sprite_start = ac.vs.sprite_start
        let idx = find_hit_enemy(lv, g)
        if idx < 0 then return
        let e = &lv.enemies[idx]
        if !enemies.ai.check_line_clear(lv, g.pos_x, g.pos_y, e.x, e.y) then return
        let depth = target_depth(g, e)
        // Tile Chebyshev for the gun damage bands — integer tile coords
        // for both endpoints, max of |dx|, |dy|. The enemy's tile is
        // the one it's heading for, as everywhere else in the AI.
        let pxi = (i32) g.pos_x
        let pyi = (i32) g.pos_y
        let { etx, ety } = enemies.ai.dest_tile(e)
        let adx = if (etx - pxi) < 0 then pxi - etx else etx - pxi
        let ady = if (ety - pyi) < 0 then pyi - ety else ety - pyi
        let tile_dist = if adx > ady then adx else ady
        let dmg = weapon_damage_roll(g, g.weapon, depth, tile_dist)
        if dmg <= 0 then return
        enemies.ai.damage_enemy(lv, g, ac, e, idx, dmg, sprite_start)
