        die_frame_time = 15.0 / 70.0, die_hold_time = 0.0 / 70.0, scream_delay = 0.0 / 70.0,
        dead_frame = 295,
        shoot_frames = i32[9] { 294, 0, 0, 0, 0, 0, 0, 0, 0 },
